<?xml version="1.0" encoding="utf-8"?>
<!--
  1.224n：视频渲染面改用 **TextureView**（而不是默认的 SurfaceView）。

  为什么：真机崩溃取证（多份小米原生崩溃报告）显示崩溃路径是
    SurfaceView$SurfaceViewPositionUpdateListener.positionChanged
    → SurfaceView.onSetSurfacePositionAndScale
    → SurfaceControl$Transaction.setPosition("SurfaceControl 为 null 时被用于设置位置")
    → libgui.so 空指针解引用 / 引用计数断言
  即：**SurfaceView 那套"独立 Surface + SurfaceControl 位置事务"机制**在这台设备上会崩。
  TextureView 是普通视图，没有 SurfaceControl、没有位置更新事务 —— 整条路径不存在，
  而且它天然支持 alpha/缩放（将来恢复"裁黑边"也安全）。

  注意：media3 1.8 的 PlayerView 依然支持 TextureView（surface_type=texture_view），
  之前的代码注释说"1.8 不再支持"是过时/错误的。
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/huzai_video_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:shutter_background_color="#000000" />
