# 统一换行符，跨平台一致（默认按文本处理，LF 存储）
* text=auto eol=lf

# 显式声明二进制，避免 Git 误判 / 无效 diff
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.apk binary
*.aab binary
*.jar binary
*.jks binary
*.keystore binary
*.ttf binary
*.otf binary
*.so binary

# 脚本换行符
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# 源码与配置
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.pro text eol=lf
*.md text eol=lf
